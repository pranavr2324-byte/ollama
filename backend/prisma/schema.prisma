generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  name           String?
  passwordHash   String?          @map("password_hash")
  supabaseId     String?          @unique @map("supabase_id")
  role           Role             @default(USER)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  playlists      Playlist[]
  favourites     Favourite[]
  recentlyPlayed RecentlyPlayed[]

  @@map("users")
}

model Artist {
  id               String   @id @default(uuid())
  name             String
  biography        String?
  artworkUrl       String?  @map("artwork_url")
  monthlyListeners String   @default("0 Monthly Listeners") @map("monthly_listeners")
  createdAt        DateTime @default(now()) @map("created_at")
  albums           Album[]
  songs            Song[]

  @@index([name])
  @@map("artists")
}

model Album {
  id          String    @id @default(uuid())
  title       String
  artistId    String    @map("artist_id")
  artworkUrl  String?   @map("artwork_url")
  releaseDate DateTime? @map("release_date")
  genre       String    @default("Various")
  createdAt   DateTime  @default(now()) @map("created_at")

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  songs  Song[]

  @@index([artistId])
  @@index([title])
  @@map("albums")
}

model Song {
  id                     String    @id @default(uuid())
  title                  String
  artistId               String    @map("artist_id")
  albumId                String?   @map("album_id")
  cloudinaryPublicId     String    @unique @map("cloudinary_public_id")
  cloudinaryResourceType String    @default("video") @map("cloudinary_resource_type")
  originalFilename       String?   @map("original_filename")
  audioFormat            String?   @map("audio_format")
  durationSeconds        Int       @default(0) @map("duration_seconds")
  fileSizeBytes          BigInt?   @map("file_size_bytes")
  bitrate                Int?
  artworkUrl             String?   @map("artwork_url")
  genre                  String    @default("Various")
  releaseDate            DateTime? @map("release_date")
  isPublished            Boolean   @default(true) @map("is_published")
  playCount              BigInt    @default(0) @map("play_count")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  artist         Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album          Album?           @relation(fields: [albumId], references: [id], onDelete: SetNull)
  playlistSongs  PlaylistSong[]
  favourites     Favourite[]
  recentlyPlayed RecentlyPlayed[]

  @@index([artistId])
  @@index([albumId])
  @@index([title])
  @@index([genre])
  @@index([isPublished])
  @@map("songs")
}

model Playlist {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  artworkUrl  String?  @map("artwork_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs PlaylistSong[]

  @@index([userId])
  @@map("playlists")
}

model PlaylistSong {
  playlistId String   @map("playlist_id")
  songId     String   @map("song_id")
  position   Int
  addedAt    DateTime @default(now()) @map("added_at")

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
  @@index([playlistId, position])
  @@map("playlist_songs")
}

model Favourite {
  userId    String   @map("user_id")
  songId    String   @map("song_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
  @@index([userId])
  @@map("favourites")
}

model RecentlyPlayed {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  songId   String   @map("song_id")
  playedAt DateTime @default(now()) @map("played_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt(sort: Desc)])
  @@map("recently_played")
}

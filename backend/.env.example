# Database (Supabase PostgreSQL connection string)
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require"

# Supabase Auth
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Cloudinary (Backend only — NEVER expose in Android APK)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_MUSIC_FOLDER="vibe/music"
CLOUDINARY_SIGNED_URLS="false"

# Server & Security
JWT_SECRET="replace-with-a-strong-random-secret-at-least-32-chars"
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="*"

# Android Client Reference (use 10.0.2.2 for Android Emulator)
ANDROID_API_BASE_URL="http://10.0.2.2:4000/api/v1/"
